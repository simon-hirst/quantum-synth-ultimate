import (
    "encoding/json"
    "net/http"
    "os"
    "strings"
    "time"

    "github.com/gorilla/handlers"
    "github.com/gorilla/mux"
    "github.com/gorilla/websocket"
)

var (
    appVersion     = "dev" // overridden via -ldflags "-X main.appVersion=$(GIT_SHA)"
    appBuildTime   = "unknown"

    // ENV
    listenAddr     = getenv("PORT", "8080")
    allowedOrigins = splitAndTrim(os.Getenv("ALLOWED_ORIGINS")) // CSV. Empty = allow all.
    serveStaticDir = getenv("STATIC_DIR", "./frontend/dist")    // where Vite build outputs
)

func getenv(k, def string) string {
    if v := os.Getenv(k); v != "" {
        return v
    }
    return def
}

func splitAndTrim(csv string) []string {
    if csv == "" {
        return nil
    }
    parts := strings.Split(csv, ",")
    out := make([]string, 0, len(parts))
    for _, p := range parts {
        t := strings.TrimSpace(p)
        if t != "" {
            out = append(out, t)
        }
    }
    return out
}

function h<K extends keyof HTMLElementTagNameMap>(
  tag: K,
  cls?: string,
  html?: string,
) {
  const el = document.createElement(tag);
  if (cls) el.className = cls;
  if (html) el.innerHTML = html;
  return el;
}

func healthHandler(w http.ResponseWriter, r *http.Request) {
    w.Header().Set("Content-Type", "application/json")
    w.WriteHeader(http.StatusOK)
    _ = json.NewEncoder(w).Encode(map[string]any{
        "status": "ok",
        "time":   time.Now().UTC().Format(time.RFC3339),
    })
}

func versionHandler(w http.ResponseWriter, r *http.Request) {
    w.Header().Set("Content-Type", "application/json")
    _ = json.NewEncoder(w).Encode(map[string]string{
        "version":   appVersion,
        "buildTime": appBuildTime,
    })
}

var wsUpgrader = websocket.Upgrader{
    ReadBufferSize:  1024,
    WriteBufferSize: 1024,
    CheckOrigin: func(r *http.Request) bool {
        // Allow all if no allowlist is provided
        if len(allowedOrigins) == 0 {
            return true
        }
        origin := r.Header.Get("Origin")
        for _, o := range allowedOrigins {
            if strings.EqualFold(o, origin) {
                return true
            }
        }
        return false
    },
}

router := mux.NewRouter()

// API routes
api := router.PathPrefix("/api").Subrouter()
api.HandleFunc("/health", healthHandler).Methods("GET")
api.HandleFunc("/version", versionHandler).Methods("GET")
// keep your other /api/* routes here

// WebSocket handler at /ws (keep your existing handler logic)
router.HandleFunc("/ws", yourWSHandler)

// Serve static in production (single-page app)
if info, err := os.Stat(serveStaticDir); err == nil && info.IsDir() {
    fs := http.FileServer(http.Dir(serveStaticDir))
    // Serve assets
    router.PathPrefix("/assets/").Handler(fs)
    // SPA fallback: let the frontend router handle unknown paths
    router.PathPrefix("/").HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
        // Serve index.html
        http.ServeFile(w, r, serveStaticDir+"/index.html")
    })
}

// CORS: allowlist if provided, otherwise permissive but NO credentials
corsOpts := []handlers.CORSOption{
    handlers.AllowedMethods([]string{"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"}),
    handlers.AllowedHeaders([]string{"Content-Type", "Authorization"}),
}

if len(allowedOrigins) == 0 {
    corsOpts = append(corsOpts, handlers.AllowedOrigins([]string{"*"}))
} else {
    corsOpts = append(corsOpts, handlers.AllowedOrigins(allowedOrigins))
}

// Important: do NOT use AllowCredentials with "*" origin. Only enable it if you set explicit origins and truly need cookies.
handler := handlers.CORS(corsOpts...)(
    handlers.ProxyHeaders(router), // trust X-Forwarded-* from reverse proxies
)

// Start server
srv := &http.Server{
    Addr:              ":" + listenAddr,
    Handler:           handler,
    ReadHeaderTimeout: 5 * time.Second,
}

if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
    panic(err)
}

