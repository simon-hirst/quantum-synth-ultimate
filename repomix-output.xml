import "./style.css";
import { NeuralVisualizer } from "./neural-visualizer";
import { StepSequencer } from "./synth";
import QRCode from "qrcode";

const canvas = document.getElementById("visual") as HTMLCanvasElement;
const viz = new NeuralVisualizer(canvas);
viz.bindHotkeys();

// connection chip
const chip = document.createElement("div");
chip.style.cssText = "position:fixed;top:10px;left:10px;z-index:30;padding:6px 10px;border-radius:999px;font:12px system-ui;background:#6B7280;color:#fff;opacity:.9";
chip.textContent = "WS: …";
document.body.appendChild(chip);
viz.onConnection = (s) => {
  chip.textContent = `WS: ${s}`;
  chip.style.background = s === "connected" ? "#10B981" : s === "error" ? "#EF4444" : "#6B7280";
};

// control panel
(function panel(){
  const wrap = document.createElement("div");
  wrap.style.cssText = "position:fixed;top:10px;right:10px;z-index:20;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);color:#fff;font:13px system-ui;padding:10px 12px;border-radius:12px;display:flex;gap:10px;align-items:center";
  const btn = (label:string, on:()=>void, bg="#4F46E5") => {
    const b = document.createElement("button");
    b.textContent = label;
    b.style.cssText = `padding:6px 10px;border:0;border-radius:8px;background:${bg};color:#fff;cursor:pointer`;
    b.onclick = on; return b;
  };
  const label = (text:string, el:HTMLElement) => {
    const s = document.createElement("div");
    s.style.cssText = "display:flex;gap:6px;align-items:center";
    const t = document.createElement("span"); t.textContent = text; t.style.opacity = "0.8";
    s.append(t, el); return s;
  };

  wrap.append(
    btn("System", ()=>viz.startAudioProcessing("display")),
    btn("Mic",    ()=>viz.startAudioProcessing("mic")),
    btn("Demo",   ()=>viz.startAudioProcessing("osc"), "#10B981"),
  );

  const sm = document.createElement("input");
  sm.type = "range"; sm.min = "0"; sm.max = "0.99"; sm.step = "0.01"; sm.value = "0.8";
  sm.oninput = () => viz.setSmoothing(parseFloat(sm.value));
  wrap.append(label("Smoothing", sm));

  const sel = document.createElement("select");
  [512,1024,2048,4096,8192].forEach(n=>{
    const o = document.createElement("option"); o.value=String(n); o.text=String(n); sel.append(o);
  });
  sel.value = "2048";
  sel.onchange = () => viz.setFftSize(parseInt(sel.value,10) as any);
  wrap.append(label("FFT", sel));

  const gain = document.createElement("input");
  gain.type = "range"; gain.min = "0.1"; gain.max = "5"; gain.step = "0.1"; gain.value = "1";
  gain.oninput = () => viz.setGain(parseFloat(gain.value));
  wrap.append(label("Sensitivity", gain));

  const theme = document.createElement("select");
  ["Purple","Neon","Sunset","Lush","Candy"].forEach(n => {
    const o = document.createElement("option"); o.value=n; o.text=n; theme.append(o);
  });
  theme.onchange = () => viz.setTheme(theme.value as any);
  theme.value = "Purple";
  wrap.append(label("Theme", theme));

  const fsc = btn("Fullscreen", ()=>{
    if (!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  }, "#374151");
  wrap.append(fsc);

  document.body.append(wrap);
})();

// share panel (copy + QR)
(function sharePanel(){
  const wrap = document.createElement("div");
  wrap.style.cssText = "position:fixed;bottom:10px;right:10px;z-index:30;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);color:#fff;font:13px system-ui;padding:10px 12px;border-radius:12px;display:flex;gap:10px;align-items:center";
  const btn = (label:string, on:()=>void, bg="#10B981") => {
    const b = document.createElement("button");
    b.textContent = label;
    b.style.cssText = `padding:6px 10px;border:0;border-radius:8px;background:${bg};color:#000;cursor:pointer;font-weight:600`;
    b.onclick = on; return b;
  };
  const url = location.origin;
  const link = document.createElement("a");
  link.href = url; link.textContent = url;
  link.style.cssText = "color:#fff;text-decoration:underline;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap";
  const copy = btn("Copy", ()=>navigator.clipboard?.writeText(url));
  const qr   = btn("QR", async ()=>{
    const dlg = document.createElement("div");
    dlg.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:40";
    const box = document.createElement("div");
    box.style.cssText = "background:#111;padding:16px;border-radius:12px;display:flex;flex-direction:column;gap:8px;align-items:center";
    const canvas = document.createElement("canvas");
    await QRCode.toCanvas(canvas, url, { margin:1, width:240 });
    const close = btn("Close", ()=>dlg.remove(), "#EF4444");
    box.append(canvas, close); dlg.append(box); document.body.append(dlg);
  });
  wrap.append(link, copy, qr);
  document.body.append(wrap);
})();

// simple 16-step sequencer
(function seqUI(){
  const seq = new StepSequencer();
  const wrap = document.createElement("div");
  wrap.style.cssText = "position:fixed;bottom:10px;left:10px;z-index:30;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);color:#fff;font:13px system-ui;padding:10px 12px;border-radius:12px;display:flex;gap:12px;align-items:center";
  const mkBtn = (t:string, on:()=>void, bg="#4F46E5")=>{
    const b=document.createElement("button"); b.textContent=t;
    b.style.cssText=`padding:6px 10px;border:0;border-radius:8px;background:${bg};color:#fff;cursor:pointer`;
    b.onclick=on; return b;
  };
  const grid = document.createElement("div");
  grid.style.cssText = "display:grid;grid-template-columns:repeat(16,18px);gap:4px;align-items:center";
  for (let i=0;i<16;i++){
    const c = document.createElement("div");
    c.style.cssText="width:18px;height:18px;border-radius:4px;background:#222;border:1px solid rgba(255,255,255,.1);cursor:pointer";
    c.onclick = ()=>{ const on=!c.classList.contains("on"); seq.setStep(i,on); c.classList.toggle("on",on); c.style.background=on?"#10B981":"#222"; };
    grid.appendChild(c);
  }
  const bpm = document.createElement("input");
  bpm.type="range"; bpm.min="60"; bpm.max="180"; bpm.step="1"; bpm.value="120";
  bpm.oninput = ()=>seq.setBpm(parseInt(bpm.value,10));
  const bpmWrap = document.createElement("div");
  bpmWrap.style.cssText="display:flex;gap:6px;align-items:center";
  const lab=document.createElement("span"); lab.textContent="BPM"; lab.style.opacity="0.8";
  bpmWrap.append(lab,bpm);

  wrap.append(
    mkBtn("Play", ()=>seq.start()),
    mkBtn("Stop", ()=>seq.stop(), "#374151"),
    bpmWrap, grid
  );
  document.body.append(wrap);
})();
