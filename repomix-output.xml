/* frontend/src/style.css */
html, body, #app {
  height: 100%;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #000;
}
#quantumCanvas {
  display: block;
  width: 100vw;
  height: 100vh;
}
a {
  color: var(--accent);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}

.qs-shell {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 18px;
  height: 100%;
  padding: 18px;
}

.qs-side {
  background: linear-gradient(180deg, var(--panel), var(--panel2));
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.brand .dot {
  width: 10px;
  height: 10px;
  border-radius: 9999px;
  background: radial-gradient(circle at 30% 30%, var(--accent2), var(--accent));
  box-shadow: 0 0 20px var(--ring);
}
.brand .title {
  font-weight: 800;
  letter-spacing: 0.3px;
  font-size: 20px;
}
.brand .subtitle {
  margin-left: auto;
  color: var(--muted);
  font-size: 12px;
  opacity: 0.8;
}

.controls {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
  margin-bottom: 18px;
}
.btn {
